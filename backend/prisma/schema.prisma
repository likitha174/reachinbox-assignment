generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Email {
  id            String   @id @default(uuid())
  recipient     String
  subject       String
  body          String
  scheduledTime DateTime
  sentAt        DateTime?
  status        EmailStatus @default(SCHEDULED)
  jobId         String?  @unique
  senderEmail   String?
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([scheduledTime])
  @@index([recipient])
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}