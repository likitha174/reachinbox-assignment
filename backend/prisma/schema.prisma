generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Email {
  id            String      @id @default(uuid())
  recipient     String
  subject       String
  body          String
  scheduledTime DateTime
  sentAt        DateTime?
  status        EmailStatus @default(SCHEDULED)
  jobId         String?     @unique
  senderId      String?
  sender        Sender?     @relation(fields: [senderId], references: [id])
  errorMessage  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
  @@index([scheduledTime])
  @@index([recipient])
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

model Sender {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emails Email[]
}

model SlackConnection {
  id            String   @id @default(uuid())
  workspaceId   String?
  workspaceName String?
  accessToken   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}